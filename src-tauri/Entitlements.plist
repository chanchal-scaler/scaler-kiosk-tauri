<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened Runtime resource-access entitlement. Signed/notarized builds are denied
       camera access without it. The microphone is not used, so there is no audio-input entitlement. Screen Recording has no entitlement;
       macOS prompts for it the first time the page calls getDisplayMedia(). -->
  <key>com.apple.security.device.camera</key>
  <true/>
</dict>
</plist>
